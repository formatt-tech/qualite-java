# Format de base commun à tous les éditeurs
# Un seul fichier, à la racine du dépôt, même avec plusieurs modules
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 100

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne = saut de ligne en Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
