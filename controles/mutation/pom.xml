<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent : les tests de mutation, par PIT ; sous le seuil de mutants détectés, le build échoue. Ses projets ne déclarent rien d'autre que lui. -->
  <groupId>io.github.formatttech.qualite.mutation</groupId>
  <artifactId>mutation</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Qualité Java - Mutation</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <junit.version>6.1.3</junit.version>
    <pitest-maven.version>1.30.1</pitest-maven.version>
    <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest-maven.version}</version>
        <dependencies>
          <!-- Le greffon qui permet à PIT de lancer les tests JUnit Jupiter -->
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5-plugin.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- Part minimale des mutants que les tests doivent détecter (tuer), en pourcentage -->
          <mutationThreshold>80</mutationThreshold>
          <!-- Rapport toujours au même endroit : target/pit-reports/index.html -->
          <timestampedReports>false</timestampedReports>
        </configuration>
        <executions>
          <!-- Après les tests, qui doivent d'abord passer tels quels -->
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>mutationCoverage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
