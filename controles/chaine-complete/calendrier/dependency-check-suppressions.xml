<?xml version="1.0" encoding="UTF-8"?>
<!--
  Failles signalées par OWASP Dependency-Check et acceptées après examen. Ce n'est pas une liste de dépendances
  exclues : chaque entrée vise UNE faille sur UNE dépendance ; toute autre faille continue de faire échouer le build.

  Avant d'ajouter une entrée :
  - correctif disponible : monter de version, ne rien ajouter ici ;
  - faux positif (composant mal identifié) : entrée sans échéance, preuve dans <notes> ;
  - faille réelle, sans correctif, non exploitable dans ce projet : entrée avec une échéance (until) ;
    à cette date, le build échoue de nouveau et la décision est réexaminée.

  Modèle :
  <suppress until="2027-01-31Z">
    <notes>Pourquoi la faille ne nous concerne pas ; qui a décidé, quand</notes>
    <packageUrl regex="true">^pkg:maven/org\.exemple/bibliotheque@.*$</packageUrl>
    <cve>CVE-2026-12345</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
