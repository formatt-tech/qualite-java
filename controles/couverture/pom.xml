<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent : la couverture des tests, mesurée par JaCoCo ; sous le seuil, le build échoue. Ses projets ne déclarent rien d'autre que lui. -->
  <groupId>io.github.formatttech.qualite.couverture</groupId>
  <artifactId>couverture</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Qualité Java - Couverture</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <junit.version>6.1.3</junit.version>
    <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <!-- Pendant les tests, un agent note chaque ligne et chaque branche exécutée (target/jacoco.exec) -->
          <execution>
            <id>mesure</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- Rapport lisible (target/site/jacoco/index.html), produit avant la vérification : il reste disponible si elle échoue -->
          <execution>
            <id>rapport</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- Le build échoue (phase verify) si le projet passe sous l'un des seuils -->
          <execution>
            <id>seuils</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <!-- Les branches : une ligne exécutée n'a pas forcément été testée dans tous ses cas -->
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
