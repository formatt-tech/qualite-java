<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent : le formatage par le formateur Eclipse, réglé par un profil exporté d'Eclipse. Ses projets ne déclarent rien d'autre que lui. -->
  <groupId>io.github.formatttech.qualite.formatage</groupId>
  <artifactId>eclipse</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Qualité Java - Formatage - Eclipse</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
    <!-- Profil de formatage, à côté de ce POM ; évalué dans chaque projet, d'où le ../ -->
    <formateur.eclipse>${project.basedir}/../formateur-eclipse.xml</formateur.eclipse>
  </properties>

  <build>
    <plugins>
      <!-- Le build échoue sur un fichier non formaté (phase verify) ; ./mvnw spotless:apply le corrige -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <!-- Version du formateur : celle par défaut de Spotless. Réglages : le profil, comme dans Eclipse ou IntelliJ
                 (Code Style → Import Scheme → Eclipse XML Profile) -->
            <eclipse>
              <file>${formateur.eclipse}</file>
            </eclipse>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
